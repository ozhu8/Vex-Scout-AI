# Copy this file to .env and fill in your own keys. Never commit .env.

# RobotEvents API token: https://www.robotevents.com/api/v2 -> Access Tokens
ROBOTEVENTS_TOKEN=
# ROBOTEVENTS_BASE_URL=https://events.vex.com/api/v2

# Claude (required for AI features)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ChatGPT, second panel agent (optional): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.1-sol

# Gemini, third panel agent (optional): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Your team (pre-fills "you" and lists your season's events)
MY_TEAM_NUMBER=
MY_TEAM_ID=
SEASON_ID=
